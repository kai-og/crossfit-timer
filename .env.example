# Copy to .env.local for local development. Never commit real values.

# Neon Postgres connection string (Vercel's Neon integration sets this automatically)
DATABASE_URL=

# Auth.js: generate with `npx auth secret` or `openssl rand -base64 33`
AUTH_SECRET=

# Google OAuth client (Google Cloud Console > APIs & Services > Credentials)
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=
